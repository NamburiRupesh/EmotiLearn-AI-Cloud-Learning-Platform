# =====================================================================
# EmotiLearn Platform - Environment Configuration
# =====================================================================

# Flask Application Secret Key (Generate a random string for production)
SECRET_KEY=change-this-to-a-secure-random-secret-key

# Option 1: Single Cloud Database URL (TiDB Cloud, Aiven, Railway, etc.)
# If DATABASE_URL is set, it will be prioritized over individual variables.
# Format: mysql://<USER>:<PASSWORD>@<HOST>:<PORT>/<DATABASE>?ssl=true
# DATABASE_URL=mysql://root:password@gateway01.us-east-1.prod.aws.tidbcloud.com:4000/emotilearn_db

# Option 2: Individual Connection Variables
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_password
MYSQL_DATABASE=emotilearn_db

# SSL for Cloud MySQL:
# Set to 'true' for TiDB Cloud / Aiven / AWS RDS.
# If connecting to localhost, it automatically disables SSL unless set to 'true'.
MYSQL_SSL=false

# Optional: Path to custom CA cert (if required by your cloud provider)
# MYSQL_SSL_CA=/path/to/ca.pem
